// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES
// OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND
// NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT
// HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY,
// WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
// FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR
// OTHER DEALINGS IN THE SOFTWARE.

load(__DIR__ + 'Libraries/polyfills/readfully.js');
const _ = require(__DIR__ + 'Libraries/lodash/full.js');
const marked = require(__DIR__ + 'Libraries/marked.js');
load(__DIR__ + 'Libraries/view2svg/diagramAppearancePrefs.js');
load(__DIR__ + 'Libraries/view2svg/archiFigureLibrary.js');
load(__DIR__ + 'Libraries/view2svg/archiRelationshipLibrary.js');
load(__DIR__ + 'Libraries/view2svg/viewToSvgSemantic.js');

const BASE_URL = './';

console.clear();
console.show();

// Use Mustache.js-style templating
_.templateSettings = {
  interpolate: /\{\{(.+?)\}\}/g
};

// Set Markdown rendering options
var mdOptions = {
  gfm: true,
  breaks: true,
  smartLists: true,
  smartypants: true
};

var roboto = readFully(__DIR__ + 'resources/roboto.css', 'UTF-8');
var icon = readFully(__DIR__ + 'resources/icon.css', 'UTF-8');
var picnic = readFully(__DIR__ + 'resources/picnic-custom.css', 'UTF-8');

var tplMainReport = _.template(readFully(__DIR__ + 'templates/main-report.html', 'UTF-8'));
var tplInputCheckbox = _.template(readFully(__DIR__ + 'templates/input-checkbox.tpl', 'UTF-8'));
var tplTreeView = _.template(readFully(__DIR__ + 'templates/model-tree-view.tpl', 'UTF-8'));
var tplTreeFolder = _.template(readFully(__DIR__ + 'templates/model-tree-folder.tpl', 'UTF-8'));
var tplView = _.template(readFully(__DIR__ + 'templates/view.tpl', 'UTF-8'));
var tplViewHotspot = _.template(readFully(__DIR__ + 'templates/view-hotspot.tpl', 'UTF-8'));
var tplViewObjectDialog = _.template(readFully(__DIR__ + 'templates/view-object-dialog.tpl', 'UTF-8'));
var tplViewObjectPropertyRow = _.template(readFully(__DIR__ + 'templates/view-object-property-row.tpl', 'UTF-8'));

var modelSelectorId = 'id-model-selector';
var modelArticleId = 'id-model';
var dialogNoneSelectorId = 'id-dialog-none';

var treeFolder = '';
var treeContent = '';
var viewInputs = '';
var viewVisibilityRules = '';
var views = '';
var dialogs = '';
var dialogInputs = '';
var dialogVisibilityRules = '';
var dialogByConceptId = {};

var allFolders = $('folder');
var viewsFolder = $(model).children().filter('folder.Views');
var viewFolders = viewsFolder.find('folder');
var nonViewFolders = allFolders.not(viewsFolder).not(viewFolders);

var folders = selection.filter("folder").not(nonViewFolders);

if(! folders.size()) {
  folders = viewsFolder;
  console.log("All views have been selected.");
}

// var targetDirectory = window.promptOpenDirectory({ title: "Select target directory" });
var targetDirectory = '/Users/lauvigne/Documents/Archi/scripts/jarchi-View2SingleHTML/dist/All-SVG';

if(!targetDirectory) {
  console.log('User cancelled.');
  exit();
}

var filePath = targetDirectory + "/index.html";
var imagesDirectory = targetDirectory + "/images";
ensureDirectoryExists(imagesDirectory);

_(folders).sortBy('name').each(function(f) {
  exportViews(f);
});

function exportViews(folder) {
  //console.log("Checking", folder.name, ":", !folder.prop("_hide_from_export_") || folder.prop("_hide_from_export_") != "true");

  if (!folder.prop("_hide_from_export_") || folder.prop("_hide_from_export_") != "true") {
    console.log('Exporting folder "' + folder.name + '"...');
    var previousContent = treeContent;
    treeContent = '';
    _($(folder).children('folder')).sortBy('name').each(function(f) {
      exportViews(f)
    });
    _($(folder).children('view')).sortBy('name').each(function(v) {
      if (!v.prop("_hide_from_export_") || v.prop("_hide_from_export_") != "true") {
        console.log('> Exporting view "' + v.name + '"...');
        // Generate report's fragments
        var viewDomId = getViewDomId(v.id);
        var viewSelectorId = getViewSelectorId(v.id);
        treeContent += tplTreeView({viewId: viewSelectorId, viewName: _.escape(v.name)});
        viewInputs += tplInputCheckbox({viewId: viewSelectorId});
        viewVisibilityRules += '#'+viewSelectorId+':checked ~ * #views > article#'+viewDomId+'{display:block;}';
        
        var svgMarkup = viewToSvgSemantic.exportViewToSemanticSvg(v, {
          fontFamily: 'Arial, sans-serif',
          fontFaceFamily: 'ArchiCustom',
          fontFaceUrl: ''
        });
        var viewInteraction = buildViewInteraction(v);
        var viewHotspots = buildViewHotspots(svgMarkup, viewInteraction);
        $.fs.writeFile(imagesDirectory + "/" + v.id + ".svg", svgMarkup, 'UTF8');

        // Generate View's article tag
        views += tplView({
          viewId: viewDomId,
          viewName: _.escape(v.name),
          viewImagePath: "images/" + v.id + ".svg",
          hotspots: viewHotspots,
          documentationText: _.escape(v.documentation).replace(/\n/g, '<br>'),
          documentationMarkdown: marked(_.escape(v.documentation), mdOptions)
        });
      }
    });
    treeContent = tplTreeFolder({folderId: 'id-'+folder.id, folderName: _.escape(folder.name), folderContent: treeContent});
    treeContent = previousContent + treeContent;
  }
}

function buildViewInteraction(view) {
  var state = {
    viewId: getViewDomId(view.id),
    viewLinks: [],
    detailLinks: [],
    seenObjectIds: {}
  };
  collectViewInteraction(view, { x: 0, y: 0 }, state);
  return state;
}

function buildViewHotspots(svgMarkup, interaction) {
  var viewBox = extractSvgViewBox(svgMarkup);
  if (!viewBox) {
    return '';
  }
  var hotspots = '';
  interaction.viewLinks.forEach(function(link) {
    var rect = toViewPercentRect(link.x, link.y, link.width, link.height, viewBox);
    if (!rect) {
      return;
    }
    hotspots += tplViewHotspot({
      id: link.targetViewId,
      hotspotClass: 'viewref-hotspot',
      left: rect.left,
      top: rect.top,
      width: rect.width,
      height: rect.height
    });
  });
  interaction.detailLinks.forEach(function(link) {
    var rect = toViewPercentRect(link.x, link.y, link.width, link.height, viewBox);
    if (!rect) {
      return;
    }
    hotspots += tplViewHotspot({
      id: link.targetSelectorId,
      hotspotClass: 'dialog-hotspot',
      left: rect.left,
      top: rect.top,
      width: rect.width,
      height: rect.height
    });
  });
  return hotspots;
}

function collectViewInteraction(obj, offset, state) {
  $(obj).children('diagram-model-reference').each(function(vRef) {
    if (vRef && vRef.id && vRef.refView && vRef.refView.id) {
      state.viewLinks.push({
        sourceObjectId: String(vRef.id),
        targetViewId: getViewSelectorId(vRef.refView.id),
        x: vRef.bounds.x + offset.x,
        y: vRef.bounds.y + offset.y,
        width: vRef.bounds.width,
        height: vRef.bounds.height
      });
    }
  });
  $(obj).children('relationship').add($(obj).children('diagram-model-connection')).add($(obj).children('canvas-model-connection')).each(function(rel) {
    addObjectDialogForSelection(rel, offset, state);
  });
  $(obj).children().not('relationship').not('diagram-model-connection').not('canvas-model-connection').not('diagram-model-reference').each(function(child) {
    addObjectDialogForSelection(child, offset, state);
  });
  $(obj).children().not('relationship').not('diagram-model-connection').not('canvas-model-connection').each(function(child) {
    collectViewInteraction(child, { x: offset.x + child.bounds.x, y: offset.y + child.bounds.y }, state);
  });
}

function addObjectDialogForSelection(diagramObject, offset, state) {
  if (!diagramObject || !diagramObject.id || !diagramObject.bounds || !diagramObject.concept) {
    return;
  }
  var objectId = String(diagramObject.id);
  if (state.seenObjectIds[objectId]) {
    return;
  }
  state.seenObjectIds[objectId] = true;

  var displayName = getDisplayName(diagramObject);
  var displayType = getDisplayType(diagramObject);
  var documentation = getDocumentation(diagramObject);
  var propertiesRows = getPropertiesRows(diagramObject.concept);
  var dialogSelectorId = ensureDialogForConcept(diagramObject.concept, displayName, displayType, documentation, propertiesRows);

  state.detailLinks.push({
    sourceObjectId: objectId,
    targetSelectorId: dialogSelectorId,
    x: diagramObject.bounds.x + offset.x,
    y: diagramObject.bounds.y + offset.y,
    width: diagramObject.bounds.width,
    height: diagramObject.bounds.height
  });
}

function ensureDialogForConcept(concept, displayName, displayType, documentation, propertiesRows) {
  if (!concept || !concept.id) {
    return dialogNoneSelectorId;
  }
  var conceptId = String(concept.id);
  if (dialogByConceptId[conceptId]) {
    return getDialogSelectorId(conceptId);
  }
  var dialogId = 'id-concept-' + conceptId;
  var dialogSelectorId = getDialogSelectorId(conceptId);
  dialogByConceptId[conceptId] = dialogId;
  dialogInputs += "<input id='" + dialogSelectorId + "' class='hidden' type='radio' name='dialogs'>";
  dialogVisibilityRules += '#' + dialogSelectorId + ':checked ~ #' + dialogId + '{display:block;}';
  dialogs += tplViewObjectDialog({
    dialogId: dialogId,
    dialogNoneSelectorId: dialogNoneSelectorId,
    objectName: _.escape(displayName),
    objectType: _.escape(displayType),
    documentationText: _.escape(documentation).replace(/\n/g, '<br>'),
    documentationMarkdown: marked(_.escape(documentation), mdOptions),
    propertiesRows: propertiesRows
  });
  return dialogSelectorId;
}

function getViewDomId(viewIdRaw) {
  var id = String(viewIdRaw || '');
  if (id.indexOf('id-') === 0) {
    return id;
  }
  return 'id-' + id;
}

function getViewSelectorId(viewIdRaw) {
  return 'sel-' + getViewDomId(viewIdRaw);
}

function getDialogSelectorId(conceptIdRaw) {
  return 'id-dialog-' + String(conceptIdRaw || '');
}

function extractSvgViewBox(svgMarkup) {
  if (!svgMarkup) {
    return null;
  }
  var viewBoxMatch = svgMarkup.match(/viewBox="([^"]+)"/);
  if (viewBoxMatch && viewBoxMatch[1]) {
    var values = viewBoxMatch[1].trim().split(/\s+/).map(Number);
    if (values.length === 4 && values.every(function(v) { return !isNaN(v); })) {
      return {
        minX: values[0],
        minY: values[1],
        width: values[2],
        height: values[3]
      };
    }
  }
  return null;
}

function toViewPercentRect(x, y, width, height, viewBox) {
  if (!viewBox || viewBox.width <= 0 || viewBox.height <= 0 || width <= 0 || height <= 0) {
    return null;
  }

  var left = ((x - viewBox.minX) / viewBox.width) * 100;
  var top = ((y - viewBox.minY) / viewBox.height) * 100;
  var right = (((x + width) - viewBox.minX) / viewBox.width) * 100;
  var bottom = (((y + height) - viewBox.minY) / viewBox.height) * 100;

  left = clampPercent(left);
  top = clampPercent(top);
  right = clampPercent(right);
  bottom = clampPercent(bottom);

  if (right <= left || bottom <= top) {
    return null;
  }

  return {
    left: formatPercent(left),
    top: formatPercent(top),
    width: formatPercent(right - left),
    height: formatPercent(bottom - top)
  };
}

function clampPercent(value) {
  return Math.max(0, Math.min(100, value));
}

function formatPercent(value) {
  return (Math.round(value * 1000) / 1000);
}

function getDisplayName(diagramObject) {
  if (diagramObject.concept && diagramObject.concept.name) {
    var conceptName = String(diagramObject.concept.name).trim();
    if (conceptName) {
      return conceptName;
    }
  }
  if (diagramObject.name) {
    var objectName = String(diagramObject.name).trim();
    if (objectName) {
      return objectName;
    }
  }
  return '(Unnamed)';
}

function getDisplayType(diagramObject) {
  if (diagramObject.concept && diagramObject.concept.type) {
    return String(diagramObject.concept.type);
  }
  if (diagramObject.type) {
    return String(diagramObject.type);
  }
  return 'Unknown';
}

function getDocumentation(diagramObject) {
  if (diagramObject.documentation) {
    return String(diagramObject.documentation);
  }
  return '';
}

function getPropertiesRows(concept) {
  var rows = '';
  var hasRows = false;

  concept.prop().forEach(key => {
    hasRows = true;
    rows += tplViewObjectPropertyRow({
      key,
      value: _.escape(concept.prop(key)).replace(/\n/g, '<br>')
    });
  });
  if (!hasRows) {
    rows += tplViewObjectPropertyRow({
      key: '-',
      value: '(No properties)'
    });
  }
  return rows;
}

var mainReport = tplMainReport({
  baseURL: BASE_URL,
  roboto: roboto,
  icon: icon,
  picnic: picnic,
  modelTitle: _.escape(model.name),
  modelSelectorId: modelSelectorId,
  modelArticleId: modelArticleId,
  treeContent: treeContent,
  viewInputs: viewInputs,
  viewVisibilityRules: viewVisibilityRules,
  dialogNoneSelectorId: dialogNoneSelectorId,
  dialogInputs: dialogInputs,
  dialogVisibilityRules: dialogVisibilityRules,
  views: views,
  dialogs: dialogs,
  modelPurposeText: _.escape(model.purpose).replace(/\n/g, '<br>'),
  modelPurposeMarkdown: marked(_.escape(model.purpose), mdOptions),
  sidebarBgColor: '#37474f',
	sidebarColor: '#DDDDDD',
	sidebarWidth: '350px',
	sidebarMargin: '10px',
	sidebarFooterHeight: '0px',
	headerHeight: '60px',
	headerBgColor: '#0074D9',
	headerColor: '#fff',
	mainBgColor: '#fff',
	mainColor: '#000',
	mainMargin: '20px',
	mainHeaderMargin: '35px',
	mainHeaderBgColor: '#eceff1',
	mainHeaderColor: '#546e7a',
	treeMargin: '1.3em'
});

$.fs.writeFile(filePath, mainReport, 'UTF-8');

console.log('Export terminated.');

function ensureDirectoryExists(path) {
  var File = Java.type('java.io.File');
  var dir = new File(path);
  if (!dir.exists()) {
    dir.mkdirs();
  }
}
