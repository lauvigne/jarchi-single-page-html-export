// Generate Single-page HTML Export
//
// https://github.com/archi-contribs/jarchi-single-page-html-export
//
// Requires jArchi - https://www.archimatetool.com/blog/2018/07/02/jarchi/
//
// This script creates a single HTML page which contains views contained into
// selected folders. This HTML page makes heavy use of CSS tricks to create
// a dynamic web application which doesn't rely on JavaScript.
// This non-JS approach is by design to allow the file to be previewed when
// stored on Onedrive Pro, MsTeams or SharePoint Document Library.
//
// Copyright (c) 2020 Phillip Beauvoir & Jean-Baptiste Sarrodie
//
// Permission is hereby granted, free of charge, to any person
// obtaining a copy of this software and associated documentation
// files (the "Software"), to deal in the Software without
// restriction, including without limitation the rights to use,
// copy, modify, merge, publish, distribute, sublicense, and/or sell
// copies of the Software, and to permit persons to whom the
// Software is furnished to do so, subject to the following
// conditions:
//
// The above copyright notice and this permission notice shall be
// included in all copies or substantial portions of the Software.
//
// THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND,
// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES
// OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND
// NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT
// HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY,
// WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
// FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR
// OTHER DEALINGS IN THE SOFTWARE.

// Set this to false for jArchi 1.6.0 and below or if the Archi preference "Enable Common JS support" is off
// See https://github.com/archimatetool/archi-scripting-plugin/wiki/Using-Node.js-modules
const USE_REQUIRE = true;

load(__DIR__ + 'libs/nashorn-polyfills.js');
load(__DIR__ + 'libs/utils.js');

if(USE_REQUIRE) {
  _ = require(__DIR__ + "libs/underscore-min.js");
  marked = require(__DIR__ + "libs/marked.min.js");
}
else {
  load(__DIR__ + 'libs/underscore-min.js');
  load(__DIR__ + 'libs/marked.min.js');
}

console.show();
console.clear();
ensureActiveModelOrExit(model, 'No active model selected. Open/select a model, then run the export again.');

// Use Mustache.js-style templating
_.templateSettings = {
  interpolate: /\{\{(.+?)\}\}/g
};

// Set Markdown rendering options
var mdOptions = {
  gfm: true,
  breaks: true,
  smartLists: true,
  smartypants: true
};

load(__DIR__ + 'libs/viewref-resolution.js');
load(__DIR__ + 'libs/hotspot-geometry.js');
load(__DIR__ + 'libs/concept-properties.js');
load(__DIR__ + 'libs/export-preferences.js');
// Note: helpers are loaded before runtime state is initialized.
// They rely on variables defined later (templates/options) at call time.

var roboto = readFully(__DIR__ + 'resources/roboto.css', 'UTF-8');
var icon = readFully(__DIR__ + 'resources/icon.css', 'UTF-8');
var picnic = readFully(__DIR__ + 'resources/picnic-custom.css', 'UTF-8');

var tplMainReport = _.template(readFully(__DIR__ + 'templates/main-report.html', 'UTF-8'));
var tplVisibilityRuleBold = _.template(readFully(__DIR__ + 'templates/visibility-rule-bold.tpl', 'UTF-8'));
var tplVisibilityRuleReveal = _.template(readFully(__DIR__ + 'templates/visibility-rule-reveal.tpl', 'UTF-8'));
var tplVisibilityRuleRevealBlock = _.template(readFully(__DIR__ + 'templates/visibility-rule-reveal-block.tpl', 'UTF-8'));
var tplInputCheckbox = _.template(readFully(__DIR__ + 'templates/input-checkbox.tpl', 'UTF-8'));
var tplTreeView = _.template(readFully(__DIR__ + 'templates/model-tree-view.tpl', 'UTF-8'));
var tplTreeFolder = _.template(readFully(__DIR__ + 'templates/model-tree-folder.tpl', 'UTF-8'));
var tplViewHotspotDebug = _.template(readFully(__DIR__ + 'templates/view-hotspot-debug.tpl', 'UTF-8'));
var tplViewHotspotCompact = _.template(readFully(__DIR__ + 'templates/view-hotspot-compact.tpl', 'UTF-8'));
var tplViewComponent = _.template(readFully(__DIR__ + 'templates/view-component.tpl', 'UTF-8'));
var tplViewElementPanel = _.template(readFully(__DIR__ + 'templates/view-element-panel.tpl', 'UTF-8'));
var tplElement = _.template(readFully(__DIR__ + 'templates/element.tpl', 'UTF-8'));
var tplRelationship = _.template(readFully(__DIR__ + 'templates/relationship.tpl', 'UTF-8'));

var File = Java.type('java.io.File');
var Files = Java.type('java.nio.file.Files');
var Paths = Java.type('java.nio.file.Paths');
var System = Java.type('java.lang.System');
var URI = Java.type('java.net.URI');
var StandardCharsets = Java.type('java.nio.charset.StandardCharsets');
var ImageIO = Java.type('javax.imageio.ImageIO');
var ArchiPlugin = Java.type("com.archimatetool.editor.ArchiPlugin");
var IPreferenceConstants = Java.type("com.archimatetool.editor.preferences.IPreferenceConstants");

var visibilityRulesBoldParts = [];
var visibilityRulesRevealParts = [];
var visibilityRulesRevealBlockParts = [];
var inputCheckboxParts = [];
var treeFolder = '';
var treeContent = '';
var viewComponents = [];
var viewComponentsHtml = '';
var globalElementPanelSelector = '';
var viewClassTokensByConceptId = {};
var elements = '';
var elementsCollection;
var relationships = '';
var relationshipsCollection;
var GLOBAL_ELEMENT_SELECTOR_NAME = 'selected-element-global';
var GLOBAL_ELEMENT_NONE_SELECTOR_ID = 'selected-element-none-global';
var GLOBAL_PANEL_TAB_NAME = 'selected-element-panel-tab';
var GLOBAL_PANEL_TAB_DOC_ID = 'selected-element-panel-tab-doc';
var GLOBAL_PANEL_TAB_PROPS_ID = 'selected-element-panel-tab-props';
var elementPanelSelectorByConceptId = {};
var domIdMap = {};
var domIdCounter = 0;

initViewRefResolution({
  model: model,
  _: _,
  console: console
});

var allFolders = $('folder');
var viewsFolder = $(model).children().filter('folder.Views');
var viewsRootFolder = viewsFolder && viewsFolder.first ? viewsFolder.first() : null;
var viewsRootFolderId = viewsRootFolder ? String(viewsRootFolder.id) : null;
var viewFolders = viewsFolder.find('folder');
var nonViewFolders = allFolders.not(viewsFolder).not(viewFolders);

var folders = selection.filter("folder").not(nonViewFolders);

if(! folders.size()) {
  folders = viewsFolder;
  console.log("All views have been selected.");
}

var preferencesFile = getExportPreferencesFile();
var allPreferences = readExportPreferences(preferencesFile);
var modelPreferenceKey = getModelPreferenceKey();
var rawModelPreferences = allPreferences[modelPreferenceKey] || {};
var defaultExportDirPath = getDefaultExportDirectoryPath();
var profileStore = normalizeModelPreferenceProfiles(rawModelPreferences, defaultExportDirPath);
var activeProfile = profileStore.profiles[profileStore.activeProfile];
var debugHotspots = activeProfile.debugHotspots === true;
var markdownEnabled = activeProfile.markdownEnabled !== false;
var minifyHtmlOutputEnabled = activeProfile.minifyHtmlOutput !== false;
var exportStatsEnabled = activeProfile.exportStats === true;
var hotspotZoomFactor = getHotspotZoomFactorFromArchiPreference();
initHotspotGeometry({
  _: _,
  debugHotspots: function() { return debugHotspots; },
  tplViewHotspotDebug: function() { return tplViewHotspotDebug; },
  tplViewHotspotCompact: function() { return tplViewHotspotCompact; },
  getViewDomId: getViewDomId,
  getElementSelectorDomId: getElementSelectorDomId,
  getDiagramNodeHotspotTarget: getDiagramNodeHotspotTarget,
  isViewReferenceDiagramType: isViewReferenceDiagramType
});
var exportConfig = promptExportConfigurationDialog(model.name, profileStore);
if(!exportConfig) {
  console.log('User cancelled.');
  exit();
}
profileStore = exportConfig.profileStore;
var selectedProfile = exportConfig.profile;
var exportDirPath = selectedProfile.directory;
var baseHref = selectedProfile.baseHref;
var topBannerMessage = String(selectedProfile.bannerMessage || '');
debugHotspots = selectedProfile.debugHotspots === true;
markdownEnabled = selectedProfile.markdownEnabled !== false;
minifyHtmlOutputEnabled = selectedProfile.minifyHtmlOutput !== false;
exportStatsEnabled = selectedProfile.exportStats === true;

var exportDirectory = new File(exportDirPath).getAbsoluteFile();
if(!exportDirectory.exists()) exportDirectory.mkdirs();
if(!exportDirectory.isDirectory()) {
  console.log('Export directory is invalid: ', exportDirPath);
  exit();
}
profileStore.profiles[profileStore.activeProfile].directory = exportDirectory.getPath();
profileStore.profiles[profileStore.activeProfile].baseHref = normalizeBaseHref(baseHref);
profileStore.profiles[profileStore.activeProfile].bannerMessage = topBannerMessage;
baseHref = profileStore.profiles[profileStore.activeProfile].baseHref;

var indexFilePath = new File(exportDirectory, 'index.html').getPath();
var imagesDirectory = new File(exportDirectory, 'images');
if(!imagesDirectory.exists()) imagesDirectory.mkdirs();

allPreferences[modelPreferenceKey] = profileStore;
writeExportPreferences(preferencesFile, allPreferences);

_.chain(folders).sortBy(function(f) { return f.name; }).each(function(f) {
  exportViews(f);
});

aggregateRenderedViewComponents(viewComponents);

function exportViews(folder) {
  console.log('Exporting "', folder.name, '"...');
  var previousContent = treeContent;
  var isViewsRootFolder = viewsRootFolderId && String(folder.id) === viewsRootFolderId;
  treeContent = '';
  _.chain($(folder).children('folder')).sortBy(function(f) { return f.name; }).each(function(f) {
    exportViews(f)
  });
  _.chain($(folder).children('view')).sortBy(function(v) { return v.name; }).each(function(v) {
    // Build and render one autonomous component model per view, then aggregate.
    var viewModel = buildViewModel(v);
    var renderedComponent = renderViewComponent(viewModel);
    viewComponents.push(renderedComponent);

    treeContent += renderedComponent.treeItem;
    
    // Update lists of elements and relationships
    $(v).find('element').each(function(e) {
      if(elementsCollection) {
        if(!elementsCollection.contains(e.concept)) elementsCollection.add($(e.concept));
      } else {
        elementsCollection = $(e.concept);
      }
      addViewClassTokenForConcept(e.concept && e.concept.id, v.id);
    });
    $(v).find('relationship').each(function(r) {
      if(relationshipsCollection) {
        if(!relationshipsCollection.contains(r.concept)) relationshipsCollection.add($(r.concept));
      } else {
        relationshipsCollection = $(r.concept);
      }
      addViewClassTokenForConcept(r.concept && r.concept.id, v.id);
    });
  });
  if(isViewsRootFolder) {
    treeContent = previousContent + treeContent;
  }
  else {
    treeContent = tplTreeFolder({folderId: getFolderDomId(folder.id), folderName: _.escape(folder.name), folderContent: treeContent});
    treeContent = previousContent + treeContent;
  }
}

function buildViewModel(view) {
  var viewId = getViewDomId(view.id);
  var viewImagePath = normalizeBaseHref(baseHref) + 'images/' + view.id + '.png';
  var viewImageFile = new File(imagesDirectory, view.id + '.png');
  $.model.renderViewToFile(view, viewImageFile.getPath(), "PNG");
  var imageSize = readImageSize(viewImageFile);
  if(debugHotspots) {
    console.log(
      '[hotspot debug] render view=' + String(view.id) +
      ' name="' + String(view.name || '') + '"' +
      ' file=' + viewImageFile.getPath() +
      ' size=' + String(imageSize && imageSize.width || '-') + 'x' + String(imageSize && imageSize.height || '-')
    );
  }

  return {
    rawView: view,
    viewId: viewId,
    viewName: _.escape(view.name),
    viewImagePath: viewImagePath,
    viewImageSize: imageSize,
    documentationContent: renderDocumentationContent(view.documentation || '')
  };
}

function renderViewComponent(viewModel) {
  var viewInteraction = buildViewInteraction(viewModel.rawView, viewModel.viewImageSize, hotspotZoomFactor);
  var debugBounds = getDebugScriptBoundsSize(viewModel.viewImageSize, hotspotZoomFactor);
  var rawWidth = viewModel.viewImageSize && viewModel.viewImageSize.width ? String(viewModel.viewImageSize.width) : '';
  var rawHeight = viewModel.viewImageSize && viewModel.viewImageSize.height ? String(viewModel.viewImageSize.height) : '';

  return {
    treeItem: tplTreeView({
      viewId: viewModel.viewId,
      viewName: viewModel.viewName
    }),
    visibilityBoldRule: tplVisibilityRuleBold({
      viewId: viewModel.viewId
    }),
    visibilityRevealRule: tplVisibilityRuleReveal({
      viewId: viewModel.viewId
    }),
    visibilityRevealBlockRule: tplVisibilityRuleRevealBlock({
      viewId: viewModel.viewId
    }),
    inputCheckbox: tplInputCheckbox({
      viewId: viewModel.viewId
    }),
    viewComponent: tplViewComponent({
      viewId: viewModel.viewId,
      viewName: viewModel.viewName,
      viewImagePath: viewModel.viewImagePath,
      viewImageWidth: rawWidth,
      viewImageHeight: rawHeight,
      viewImageZoomedWidth: debugBounds.width,
      viewImageZoomedHeight: debugBounds.height,
      viewZoomFactor: String(hotspotZoomFactor || 1),
      viewHotspots: viewInteraction.hotspots,
      documentationContent: viewModel.documentationContent
    })
  };
}

function getDebugScriptBoundsSize(imageSize, zoomFactor) {
  if(!imageSize || !imageSize.width || !imageSize.height) {
    return { width: '', height: '' };
  }
  var zoom = Number(zoomFactor);
  if(!zoom || zoom <= 0) zoom = 1;
  return {
    width: String(toInt(Number(imageSize.width) / zoom)),
    height: String(toInt(Number(imageSize.height) / zoom))
  };
}

function aggregateRenderedViewComponents(components) {
  var viewComponentParts = [];
  _.each(components, function(component) {
    visibilityRulesBoldParts.push(component.visibilityBoldRule);
    visibilityRulesRevealParts.push(component.visibilityRevealRule);
    visibilityRulesRevealBlockParts.push(component.visibilityRevealBlockRule);
    inputCheckboxParts.push(component.inputCheckbox);
    viewComponentParts.push(component.viewComponent);
  });
  viewComponentsHtml = viewComponentParts.join('');
}

globalElementPanelSelector = buildGlobalElementPanelSelector(elementsCollection);

var elementParts = [];
_.chain(elementsCollection).sortBy(function(e) { return e.name; }).each(function(e) {
  elementParts.push(tplElement({
    viewsIds: getViewClassesForConcept(e.id),
    elementName: renderConceptLink(e, _.escape(e.name)),
    elementType: properCase(e.type)
  }));
});
elements = elementParts.join('');

var relationshipParts = [];
_.chain(relationshipsCollection).sortBy(function(r) { return r.name; }).each(function(r) {
  relationshipParts.push(tplRelationship({
    viewsIds: getViewClassesForConcept(r.id),
    relationshipName: _.escape(r.name),
    relationshipType: properCase(r.type),
    relationshipSource: renderConceptLink(r.source, _.escape(r.source.name)),
    relationshipTarget: renderConceptLink(r.target, _.escape(r.target.name))
  }));
});
relationships = relationshipParts.join('');

var mainReport = tplMainReport({
  roboto: minifyHtmlOutputEnabled ? minifyCssText(roboto) : roboto,
  icon: minifyHtmlOutputEnabled ? minifyCssText(icon) : icon,
  picnic: minifyHtmlOutputEnabled ? minifyCssText(picnic) : picnic,
  baseHref: _.escape(baseHref),
  bodyClassAttr: buildBodyClassAttr(debugHotspots),
  topSnackbar: renderTopSnackbar(topBannerMessage, baseHref),
  modelTitle: _.escape(model.name),
  visibilityRulesBold: visibilityRulesBoldParts.join(''),
  visibilityRulesReveal: visibilityRulesRevealParts.join(''),
  visibilityRulesRevealBlock: visibilityRulesRevealBlockParts.join(''),
  inputCheckbox: inputCheckboxParts.join(''),
  treeContent: treeContent,
  viewComponents: viewComponentsHtml,
  globalElementPanelSelector: globalElementPanelSelector,
  modelPurposeContent: renderDocumentationContent(model.purpose || ''),
  elements: elements,
  relationships: relationships,
  sidebarBgColor: '#37474f',
	sidebarColor: '#DDDDDD',
	sidebarWidth: '350px',
	sidebarMargin: '10px',
	sidebarFooterHeight: '0px',
	headerHeight: '60px',
	headerBgColor: '#0074D9',
	headerColor: '#fff',
	mainBgColor: '#fff',
	mainColor: '#000',
	mainMargin: '20px',
	mainHeaderMargin: '35px',
	mainHeaderBgColor: '#eceff1',
	mainHeaderColor: '#546e7a',
  treeMargin: '1.3em'
});

if(exportStatsEnabled) {
  logExportStats('Before minify', mainReport);
}

if(minifyHtmlOutputEnabled) {
  mainReport = minifyInlineCssBlocks(mainReport);
  mainReport = minifyGeneratedHtml(mainReport);
}

if(exportStatsEnabled) {
  logExportStats('Final output', mainReport);
}

$.fs.writeFile(indexFilePath, mainReport, 'UTF-8');

console.log('HTML report: ', indexFilePath);
console.log('Images folder: ', imagesDirectory.getPath());
console.log('Export terminated.');

function renderDocumentationContent(rawDocumentation) {
  if(!rawDocumentation || !String(rawDocumentation).trim()) return '';
  var escaped = _.escape(rawDocumentation || '');
  if(markdownEnabled) {
    return '<div class="md">' + marked(escaped, mdOptions) + '</div>';
  }
  return '<div class="txt">' + escaped.replace(/\n/g, '<br>') + '</div>';
}

function addViewClassTokenForConcept(conceptId, viewId) {
  if(!conceptId || !viewId) return;
  var key = String(conceptId);
  var token = getViewDomId(viewId);
  var tokens = viewClassTokensByConceptId[key];
  if(!tokens) {
    tokens = [];
    viewClassTokensByConceptId[key] = tokens;
  }
  if(tokens.indexOf(token) === -1) {
    tokens.push(token);
  }
}

function getViewClassesForConcept(conceptId) {
  if(!conceptId) return '';
  var tokens = viewClassTokensByConceptId[String(conceptId)];
  if(!tokens || !tokens.length) return '';
  return tokens.join(' ');
}

function buildGlobalElementPanelSelector(allElements) {
  var panels = '';
  elementPanelSelectorByConceptId = {};
  if(allElements) {
    _.chain(allElements).sortBy(function(e) { return e.name; }).each(function(e) {
      var selectorId = getElementSelectorDomId(e.id);
      elementPanelSelectorByConceptId[String(e.id)] = selectorId;
      panels += tplViewElementPanel({
        selectorId: selectorId,
        selectorName: GLOBAL_ELEMENT_SELECTOR_NAME,
        noneSelectorId: GLOBAL_ELEMENT_NONE_SELECTOR_ID,
        elementName: _.escape(e.name || '(Unnamed)'),
        elementType: properCase(String(e.type || '')),
        elementDocumentationContent: renderElementDocumentationContent(e.documentation || ''),
        elementPropertiesContent: renderElementPropertiesContent(e),
        panelTabDocId: GLOBAL_PANEL_TAB_DOC_ID,
        panelTabPropsId: GLOBAL_PANEL_TAB_PROPS_ID
      });
    });
  }

  return (
    '<div class="view-element-selector">' +
      '<input id="' + GLOBAL_ELEMENT_NONE_SELECTOR_ID + '" class="hidden" type="radio" name="' + GLOBAL_ELEMENT_SELECTOR_NAME + '" checked>' +
      '<input id="' + GLOBAL_PANEL_TAB_DOC_ID + '" class="hidden" type="radio" name="' + GLOBAL_PANEL_TAB_NAME + '" checked>' +
      '<input id="' + GLOBAL_PANEL_TAB_PROPS_ID + '" class="hidden" type="radio" name="' + GLOBAL_PANEL_TAB_NAME + '">' +
      panels +
    '</div>'
  );
}

function buildBodyClassAttr(debugHotspots) {
  var classes = [];
  if(debugHotspots) classes.push('debug-hotspots');
  if(!classes.length) return '';
  return ' class="' + classes.join(' ') + '"';
}

function renderTopSnackbar(rawMessage, rawBaseHref) {
  var message = String(rawMessage || '').trim();
  if(!message) return '';
  var href = String(rawBaseHref || '').trim();
  var output = '<input id="top-snackbar-dismiss" class="hidden" type="checkbox">' +
    '<div class="top-snackbar">' +
    '<span class="top-snackbar-msg">' + _.escape(message) + '</span>';
  if(href) {
    output += '<a class="top-snackbar-url" href="' + _.escape(href) + '" target="_blank" rel="noopener noreferrer">' + _.escape(href) + '</a>';
  }
  output += '<label for="top-snackbar-dismiss" class="top-snackbar-close" title="Close">×</label></div>';
  return output;
}

function renderElementDocumentationContent(rawDocumentation) {
  var content = renderDocumentationContent(rawDocumentation || '');
  return content;
}

function getElementPanelSelectorIdForConcept(conceptId) {
  if(!conceptId) return null;
  return elementPanelSelectorByConceptId[String(conceptId)] || null;
}

function renderConceptLink(concept, fallbackText) {
  var text = fallbackText || _.escape((concept && concept.name) || '');
  var selectorId = getElementPanelSelectorIdForConcept(concept && concept.id);
  if(!selectorId) return text;
  return '<label for="' + _.escape(selectorId) + '" class="pointer clickable-link">' + text + '</label>';
}

function renderElementPropertiesContent(concept) {
  var properties = getConceptProperties(concept, _);
  if(!properties.length) {
    return '<p class="view-element-empty">No properties.</p>';
  }
  var rows = [];
  _.each(properties, function(p) {
    rows.push('<tr><td>' + _.escape(p.key) + '</td><td>' + _.escape(p.value).replace(/\n/g, '<br>') + '</td></tr>');
  });
  return '<table class="view-properties-table"><thead><tr><th>Key</th><th>Value</th></tr></thead><tbody>' + rows.join('') + '</tbody></table>';
}

function minifyGeneratedHtml(html) {
  return String(html || '')
    .replace(/>\s+</g, '><')
    .replace(/[ \t]+\n/g, '\n')
    .replace(/\n{2,}/g, '\n')
    .trim();
}

function minifyInlineCssBlocks(html) {
  return String(html || '').replace(/<style>([\s\S]*?)<\/style>/g, function(_match, css) {
    return '<style>' + minifyCssText(css) + '</style>';
  });
}

function getViewDomId(rawViewId) {
  return getShortDomId('v', rawViewId);
}

function getFolderDomId(rawFolderId) {
  return getShortDomId('f', rawFolderId);
}

function getElementSelectorDomId(rawConceptId) {
  return toBase36(getShortDomIdNumeric('e', rawConceptId));
}

function getShortDomId(kindPrefix, rawId) {
  return String(kindPrefix) + toBase36(getShortDomIdNumeric(kindPrefix, rawId));
}

function getShortDomIdNumeric(kindPrefix, rawId) {
  var key = String(kindPrefix) + ':' + String(rawId || '');
  if(!domIdMap[key]) {
    domIdCounter += 1;
    domIdMap[key] = domIdCounter;
  }
  return domIdMap[key];
}

function logExportStats(label, html) {
  var stats = computeHtmlStats(html);
  console.log('#################### EXPORT STATS (' + label + ') ####################');
  console.log('Total bytes       : ' + stats.totalBytes);
  console.log('Inline CSS bytes  : ' + stats.inlineCssBytes + ' (' + stats.inlineCssBlocks + ' blocks)');
  console.log('Hotspots bytes    : ' + stats.hotspotsBytes + ' (' + stats.hotspotCount + ' hotspots)');
  console.log('Tables bytes      : ' + stats.tablesBytes + ' (' + stats.tableCount + ' tables)');
  console.log('Panels bytes      : ' + stats.panelsBytes + ' (' + stats.panelCount + ' panels)');
  console.log('############################################################');
}

function computeHtmlStats(html) {
  var text = String(html || '');
  var inlineCssMatches = matchAll(text, /<style>([\s\S]*?)<\/style>/g);
  var hotspotMatches = matchAll(text, /<label class="view-hotspot"[^>]*><\/label>/g);
  var tableMatches = matchAll(text, /<table[\s\S]*?<\/table>/g);
  var panelMatches = matchAll(text, /<div class="view-element-panel">[\s\S]*?<\/div>/g);

  return {
    totalBytes: utf8ByteLength(text),
    inlineCssBytes: sumMatchBytes(inlineCssMatches),
    inlineCssBlocks: inlineCssMatches.length,
    hotspotsBytes: sumMatchBytes(hotspotMatches),
    hotspotCount: hotspotMatches.length,
    tablesBytes: sumMatchBytes(tableMatches),
    tableCount: tableMatches.length,
    panelsBytes: sumMatchBytes(panelMatches),
    panelCount: panelMatches.length
  };
}

function matchAll(text, pattern) {
  var matches = [];
  var m;
  while((m = pattern.exec(text)) !== null) {
    matches.push(m[0]);
  }
  return matches;
}

function sumMatchBytes(matches) {
  var total = 0;
  for(var i = 0; i < matches.length; i++) {
    total += utf8ByteLength(matches[i]);
  }
  return total;
}

function utf8ByteLength(text) {
  return String(text || '').getBytes(StandardCharsets.UTF_8).length;
}

function readImageSize(imageFile) {
  try {
    if(!imageFile || !imageFile.exists()) return null;
    var image = ImageIO.read(imageFile);
    if(!image) return null;
    return {
      width: Number(image.getWidth()),
      height: Number(image.getHeight())
    };
  }
  catch(err) {
    console.log('Unable to read image size for view export: ', err);
    return null;
  }
}
